  "validation_test_suite": {
    "url_generation_tests": {
      "description": "Validate that all url_for calls generate correct URLs",
      "test_cases": [
        {
          "test_name": "home_navigation_urls",
          "test_type": "url_generation",
          "endpoints_to_test": [
            "home.get_home",
            "home.about",
            "home.contact",
            "home.terms",
            "home.privacy"
          ],
          "expected_results": {
            "home.get_home": "/",
            "home.about": "/about",
            "home.contact": "/contact",
            "home.terms": "/terms",
            "home.privacy": "/privacy"
          },
          "validation_method": "Compare generated URLs with expected patterns"
        },
        {
          "test_name": "authentication_urls",
          "test_type": "url_generation",
          "endpoints_to_test": [
            "auth.login",
            "auth.logout",
            "auth.subscribe",
            "auth.password_reset"
          ],
          "expected_results": {
            "auth.login": "/auth/login",
            "auth.logout": "/auth/logout",
            "auth.subscribe": "/auth/subscribe",
            "auth.password_reset": "/auth/password-reset"
          },
          "validation_method": "Verify authentication URL patterns"
        },
        {
          "test_name": "job_related_urls",
          "test_type": "url_generation_with_parameters",
          "endpoints_to_test": [
            {
              "endpoint": "jobs.job_details",
              "parameters": {
                "job_id": "123e4567-e89b-12d3-a456-426614174000"
              },
              "expected": "/jobs/123e4567-e89b-12d3-a456-426614174000"
            },
            {
              "endpoint": "jobs.category_jobs",
              "parameters": {
                "category": "software-engineering"
              },
              "expected": "/jobs/category/software-engineering"
            },
            {
              "endpoint": "jobs.jobs_by_location",
              "parameters": {
                "location": "johannesburg"
              },
              "expected": "/jobs/location/johannesburg"
            }
          ],
          "validation_method": "Test parameterized URL generation"
        },
        {
          "test_name": "company_dashboard_urls",
          "test_type": "url_generation",
          "endpoints_to_test": [
            "company.view_company",
            "company.manage_jobs",
            "company.candidate_management",
            "company.application_analytics"
          ],
          "expected_results": {
            "company.view_company": "/dashboard/company/profile",
            "company.manage_jobs": "/dashboard/company/jobs",
            "company.candidate_management": "/dashboard/company/candidates",
            "company.application_analytics": "/dashboard/company/analytics/applications"
          },
          "validation_method": "Verify company dashboard URL patterns"
        }
      ]
    },
    "template_rendering_tests": {
      "description": "Test template rendering with corrected URLs",
      "test_cases": [
        {
          "test_name": "index_template_rendering",
          "template": "corrected_templates/index.html",
          "test_contexts": [
            {
              "context_name": "anonymous_user",
              "context_data": {
                "current_user": null
              },
              "expected_elements": [
                "Login and Register links visible",
                "Job search form present",
                "Public navigation menu"
              ]
            },
            {
              "context_name": "authenticated_jobseeker",
              "context_data": {
                "current_user": {
                  "is_authenticated": true,
                  "role": "jobseeker",
                  "profile_complete": true
                }
              },
              "expected_elements": [
                "Jobseeker dashboard link",
                "Job alerts and applications links",
                "Logout link visible"
              ]
            },
            {
              "context_name": "authenticated_employer",
              "context_data": {
                "current_user": {
                  "is_authenticated": true,
                  "role": "employer",
                  "company_verified": true,
                  "has_active_billing": true
                }
              },
              "expected_elements": [
                "Post job and manage jobs links",
                "Company dashboard link",
                "Employer-specific navigation"
              ]
            }
          ]
        },
        {
          "test_name": "header_template_rendering",
          "template": "corrected_templates/layouts/header.html",
          "test_contexts": [
            {
              "context_name": "role_based_navigation",
              "context_data": {
                "current_user": {
                  "is_authenticated": true,
                  "role": "employer",
                  "company_verified": false
                }
              },
              "expected_elements": [
                "Setup Company link instead of Dashboard",
                "Proper role-based conditional rendering"
              ]
            }
          ]
        },
        {
          "test_name": "jobs_list_template_rendering",
          "template": "corrected_templates/jobs/_jobs_list.html",
          "test_contexts": [
            {
              "context_name": "pagination_rendering",
              "context_data": {
                "jobs": "mock_job_list",
                "page": 2,
                "total_pages": 5,
                "request": {
                  "endpoint": "jobs.search_jobs",
                  "args": {
                    "keyword": "developer"
                  }
                }
              },
              "expected_elements": [
                "Pagination links use url_for",
                "Query parameters preserved",
                "Previous and next links functional"
              ]
            }
          ]
        }
      ]
    },
    "authentication_flow_tests": {
      "description": "Test authentication-based navigation and conditional rendering",
      "test_cases": [
        {
          "test_name": "role_based_navigation_test",
          "test_scenarios": [
            {
              "scenario": "jobseeker_navigation",
              "user_context": {
                "role": "jobseeker",
                "is_authenticated": true,
                "profile_complete": true
              },
              "expected_navigation": [
                "Dashboard link points to jobseeker.dashboard",
                "Job alerts and applications accessible",
                "Match details functionality available"
              ]
            },
            {
              "scenario": "employer_navigation",
              "user_context": {
                "role": "employer",
                "is_authenticated": true,
                "company_verified": true,
                "has_active_billing": true
              },
              "expected_navigation": [
                "Dashboard link points to company.view_company",
                "Job posting and management accessible",
                "Candidate search available"
              ]
            },
            {
              "scenario": "unverified_employer",
              "user_context": {
                "role": "employer",
                "is_authenticated": true,
                "company_verified": false
              },
              "expected_navigation": [
                "Setup company link instead of dashboard",
                "Verification prompts visible",
                "Limited functionality access"
              ]
            }
          ]
        },
        {
          "test_name": "billing_status_navigation",
          "test_scenarios": [
            {
              "scenario": "employer_with_billing",
              "user_context": {
                "role": "employer",
                "has_active_billing": true,
                "company_verified": true
              },
              "expected_behavior": [
                "Job posting links accessible",
                "Full employer functionality available"
              ]
            },
            {
              "scenario": "employer_without_billing",
              "user_context": {
                "role": "employer",
                "has_active_billing": false,
                "company_verified": true
              },
              "expected_behavior": [
                "Upgrade prompts for job posting",
                "Limited functionality access"
              ]
            }
          ]
        }
      ]
    },
