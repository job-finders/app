  "template_context_requirements": {
    "user_context": {
      "description": "User authentication context required in templates",
      "required_variables": [
        "current_user",
        "current_user.is_authenticated",
        "current_user.role",
        "current_user.uid"
      ],
      "conditional_logic": {
        "authentication_check": "{% if current_user.is_authenticated %}",
        "role_check": "{% if current_user.role == 'employer' %}",
        "permission_check": "{% if current_user.can_access_job(job.job_id) %}"
      }
    },
    "job_context": {
      "description": "Job-related context for job detail pages",
      "required_variables": [
        "job.job_id",
        "job.title",
        "job.company_name",
        "job.category",
        "job.location",
        "job.job_type",
        "job.status"
      ],
      "optional_variables": [
        "job.slug",
        "job.job_ref",
        "job.employer_id",
        "job.match_score"
      ]
    },
    "company_context": {
      "description": "Company-related context for employer pages",
      "required_variables": [
        "company.company_id",
        "company.company_name",
        "employer.employer_id",
        "employer.is_verified"
      ]
    },
    "pagination_context": {
      "description": "Pagination context for list pages",
      "required_variables": [
        "page",
        "total_pages",
        "total_jobs",
        "per_page"
      ],
      "template_logic": "{% if total_pages > 1 %}"
    }
  },
  "error_handling_requirements": {
    "parameter_validation_errors": {
      "invalid_uuid": {
        "status_code": 404,
        "template": "errors/404.html",
        "message": "Resource not found"
      },
      "invalid_slug": {
        "status_code": 404,
        "template": "errors/404.html",
        "message": "Page not found"
      },
      "invalid_token": {
        "status_code": 403,
        "template": "errors/403.html",
        "message": "Access denied or token expired"
      }
    },
    "authentication_errors": {
      "not_authenticated": {
        "redirect": "auth.login",
        "flash_message": "Please log in to access this page"
      },
      "insufficient_permissions": {
        "status_code": 403,
        "template": "errors/403.html",
        "message": "You don't have permission to access this resource"
      },
      "billing_required": {
        "redirect": "billing.upgrade",
        "flash_message": "This feature requires an active subscription"
      }
    }
  },
